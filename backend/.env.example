# Comma-separated frontend URLs allowed by CORS (no trailing slash)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-app.vercel.app

# Local development (optional — defaults to *)
# CORS_ORIGINS=http://localhost:5173

# Supabase (optional — enables persistent database)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
