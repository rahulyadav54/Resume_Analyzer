# Auth token signing secret (change in production)
# AUTH_SECRET=your-long-random-secret

# Comma-separated frontend URLs allowed by CORS (no trailing slash)
# Production example:
# CORS_ORIGINS=https://resume-analyzer-lyart-kappa.vercel.app,http://localhost:5173

# Local development (optional — defaults to *)
# CORS_ORIGINS=http://localhost:5173

# Supabase (optional — enables persistent database + real auth)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-public-key
